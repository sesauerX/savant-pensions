---
import "../styles.css";
import { SITE, faqs, pages } from "../lib/seo";

const props = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const seo = pages[path];
const title = seo?.title ?? props.title ?? "Sterling Pension Group";
const description =
  seo?.description ??
  props.description ??
  "Sterling Pension Group is a pension plan administrator for business owners. We design and administer Defined Benefit and Cash Balance plans.";
const image = props.image ?? "/og.jpg";
const type = props.type ?? "website";
const canonical = `${SITE}${path === "/" ? "/" : path}`;
const ogImage = new URL(image, SITE).href;

const nav = [
  ["/defined-benefit", "Defined Benefit"],
  ["/cash-balance", "Cash Balance"],
  ["/services", "Services"],
  ["/insights", "Insights"],
  ["/about", "About"],
  ["/contact", "Contact"],
];
const plans = [
  ["/defined-benefit", "Defined Benefit Plans"],
  ["/cash-balance", "Cash Balance Plans"],
  ["/self-employed", "Self-Employed Cash Balance"],
  ["/physicians", "Physicians"],
  ["/dentists", "Dentists"],
  ["/attorneys", "Law firms"],
  ["/consultants", "Consultants"],
];
const resources = [
  ["/insights", "Owner briefing"],
  ["/limits", "2024–2026 IRS limits"],
  ["/compare", "Compare SEP, 401(k), pension"],
  ["/illustrations", "Illustrative contributions"],
  ["/not-a-fit", "When it is not a fit"],
  ["/staff-cost", "Staff cost"],
  ["/calendar", "Deadline calendar"],
  ["/fees", "Fees and who does what"],
  ["/plan-lifecycle", "After the plan exists"],
  ["/calculator", "Tax savings calculator"],
  ["/faq", "FAQs"],
  ["/contact", "Schedule a consultation"],
];

const crumbs = [{ name: "Home", url: `${SITE}/` }];
if (path.startsWith("/insights/") && props.crumb) {
  crumbs.push({ name: "Insights", url: `${SITE}/insights` });
  crumbs.push({ name: props.crumb, url: canonical });
} else if (path !== "/" && seo) {
  crumbs.push({ name: seo.crumb, url: canonical });
}

const graph: Record<string, unknown>[] = [
  {
    "@type": ["Organization", "ProfessionalService"],
    "@id": `${SITE}/#organization`,
    name: "Sterling Pension Group LLC",
    alternateName: "Sterling Pension Group",
    url: `${SITE}/`,
    logo: `${SITE}/logo.svg`,
    image: `${SITE}/og.jpg`,
    description:
      "Independent third-party administrator for Defined Benefit and Cash Balance plans used by business owners.",
    telephone: "+1-860-590-7172",
    email: "info@savantpensions.com",
    address: {
      "@type": "PostalAddress",
      streetAddress: "15 N Main St #100",
      addressLocality: "West Hartford",
      addressRegion: "CT",
      postalCode: "06107",
      addressCountry: "US",
    },
    areaServed: { "@type": "Country", name: "United States" },
    knowsAbout: ["Defined benefit plans", "Cash balance plans", "Third-party administration"],
  },
  {
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: "Sterling Pension Group",
    publisher: { "@id": `${SITE}/#organization` },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${SITE}/#website` },
    about: { "@id": `${SITE}/#organization` },
    primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  },
];

if (type === "article") {
  graph.push({
    "@type": "Article",
    headline: props.headline ?? title,
    description,
    datePublished: props.published,
    dateModified: props.modified ?? props.published,
    image: ogImage,
    author: { "@id": `${SITE}/#organization` },
    publisher: { "@id": `${SITE}/#organization` },
    mainEntityOfPage: canonical,
  });
}

if (path === "/faq") {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:site_name" content="Sterling Pension Group" />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === "/og.jpg" && <meta property="og:image:width" content="1200" />}
    {image === "/og.jpg" && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_US" />
    {props.published && <meta property="article:published_time" content={props.published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon.png?v=1" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-lLmwMkXN9UitZNJpTtI9t.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Sterling Pension Group home">
          <img src="/logo.svg?v=4" width="42" height="42" alt="" />
          <span><strong>STERLING</strong><small>PENSION GROUP</small></span>
        </a>
        <nav class="desk">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <div class="actions">
          <a class="btn ghost" href="/calculator">Estimate savings</a>
          <a class="btn primary" href="/contact">Free consultation</a>
        </div>
        <button class="menu-btn" type="button" aria-label="Open menu" id="menu-btn">☰</button>
      </div>
      <div class="wrap mobile" id="mobile-nav" hidden>
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        <a class="btn primary" href="/contact">Free consultation</a>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap cols">
        <div>
          <a class="brand" href="/"><img src="/logo.svg?v=4" width="40" height="40" alt="" /><span><strong style="color:#fff">STERLING</strong><small>PENSION GROUP</small></span></a>
          <p>Premier Defined Benefit and Cash Balance retirement consulting and third-party administration for business owners, independent consultants, and physician practices across the United States.</p>
          <p style="color:var(--gold);font-weight:700;font-size:13px;">Independent Third-Party Administration</p>
        </div>
        <div>
          <h4>Retirement plans</h4>
          {plans.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
        <div>
          <h4>Resources & insights</h4>
          {resources.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
        <div>
          <h4>Headquarters</h4>
          <p>Sterling Pension Group LLC<br />15 N Main St #100<br />West Hartford, CT 06107<br />United States</p>
          <a href="tel:+18605907172">+1 (860) 590-7172</a>
          <a href="mailto:info@savantpensions.com">info@savantpensions.com</a>
        </div>
      </div>
      <div class="wrap fine">
        <p>Professional Practice Notice: Third-Party Administrator & Defined Benefit / Cash Balance Retirement Consultants. Sterling Pension Group LLC is a pension consulting and third-party administration firm; we are not actuaries. Where mandatory certified actuarial sign-offs are required, Sterling Pension Group collaborates with independent Enrolled Actuaries.</p>
        <p>© 2026 Sterling Pension Group LLC. All rights reserved. <a href="/privacy">Your Privacy</a> · <a href="/terms">Terms of Use</a> · <a href="/disclaimer">Disclaimer</a> · <a href="/support">Client Support</a></p>
      </div>
    </footer>
    <script>
      const btn = document.getElementById("menu-btn");
      const nav = document.getElementById("mobile-nav");
      btn?.addEventListener("click", () => {
        const open = nav.hasAttribute("hidden");
        if (open) nav.removeAttribute("hidden");
        else nav.setAttribute("hidden", "");
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        btn.textContent = open ? "×" : "☰";
      });
    </script>
  </body>
</html>
