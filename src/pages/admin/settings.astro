---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { config, integrationStatus } from "../../lib/cases/config";
import { EMAIL_APPROVAL, EMAIL_TEMPLATES } from "../../lib/cases/emails";
import { IDENTITY_RETENTION_DAYS, RETENTION_POLICY } from "../../lib/cases/retention";

export const prerender = false;

const flags: [string, string][] = [
  ["LIVE_MODE", config.live() ? "true" : "false"],
  ["TEMPLATES_APPROVED", config.templatesApproved() ? "true" : "false"],
  ["AWARD_LETTER_SHOW_PASSPORT", config.showPassport() ? "true" : "false"],
  ["CASES_ENABLED", config.enabled() ? "true" : "false"],
];
const values: [string, string][] = [
  ["Inbound address", config.inboundAddress() || "–"],
  ["Allowed senders", config.allowedSenders().join(", ") || "–"],
  ["Client sender", config.clientFrom()],
  ["Reply-to", config.replyTo() || "none"],
  ["Archive BCC", config.bcc() || "none"],
  ["Test recipient", config.testRecipient() || "–"],
  ["Admin notifications", config.adminNotifyTo().join(", ") || "–"],
  ["Sterling signer", `${config.spgSignerName()} <${config.spgSignerEmail() || "not set"}>`],
  ["Claude model", config.anthropicModel()],
  ["Admin users", config.adminUsers().map((u) => `${u.name} (${u.role})`).join(", ")],
];
const status = Object.entries(integrationStatus());
---
<AdminLayout title="Settings">
  <h1>Settings</h1>
  <p class="muted small">Read-only. Values are set as Vercel environment variables; secrets are never shown.</p>
  <div class="card"><h2>Mode</h2><dl class="kv">{flags.map(([k, v]) => <><dt>{k}</dt><dd><b>{v}</b></dd></>)}</dl></div>
  <div class="card"><h2>Configuration</h2><dl class="kv">{values.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl></div>
  <div class="card"><h2>Integrations</h2><dl class="kv">{status.map(([k, ok]) => <><dt>{k}</dt><dd>{ok ? <span class="badge done">configured</span> : <span class="badge stop">missing</span>}</dd></>)}</dl></div>
  <div class="card">
    <h2>Client email templates</h2>
    <p class="small muted">English and German. Documents themselves stay English.</p>
    <table class="t small">
      <thead><tr><th>Email</th><th>English</th><th>German</th></tr></thead>
      <tbody>{EMAIL_TEMPLATES.map((t) => <tr><td>{t.name}</td>{(["en", "de"] as const).map((l) => <td>{EMAIL_APPROVAL[l].approved ? <span class="badge done">approved</span> : <span class="badge action">pending approval</span>}</td>)}</tr>)}</tbody>
    </table>
    <p class="small muted" style="margin-top:8px">German: {EMAIL_APPROVAL.de.note}. English: {EMAIL_APPROVAL.en.note}.</p>
  </div>
  <div class="card">
    <h2>Retention</h2>
    <dl class="kv small">
      <dt>Case data</dt><dd><b>{RETENTION_POLICY}.</b> Cases are never deleted automatically; "Delete case data" on a case removes it by hand.</dd>
      <dt>Identity documents</dt><dd>Attachments tagged "Identity document" are deleted {IDENTITY_RETENTION_DAYS} days after the case's details were confirmed (daily check, logged on the case). The file record stays; the scan itself is removed.</dd>
      <dt>Copies at Resend</dt><dd>Resend keeps received emails, including attachments, for 30 days on all plans and has no API to delete them. By the time the {IDENTITY_RETENTION_DAYS}-day rule runs, Resend's copy is already gone. (Shorter or custom retention is an Enterprise option at Resend; turning off content storage is a paid add-on.)</dd>
    </dl>
  </div>
  <div class="card">
    <h2>Webhooks</h2>
    <dl class="kv small">
      <dt>Resend</dt><dd>https://sterlingpensiongroup.com/api/cases/inbound (email.received)</dd>
      <dt>BoldSign</dt><dd>https://sterlingpensiongroup.com/api/cases/boldsign (Completed, Declined, Expired, Revoked)</dd>
      <dt>Cron</dt><dd>/api/cases/cron daily 07:00 UTC: BoldSign poll and reminders</dd>
    </dl>
  </div>
</AdminLayout>
