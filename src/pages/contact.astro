---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import Pic from "../components/Pic.astro";
---
<Base title="Contact | Sterling Pension Group">

<Hero overlap kicker="Complimentary first conversation" title="Contact a pension plan administrator." lede="No script. No pressure." />

<section class="wrap overlap-wrap">
  <div class="contact-grid">
    <ContactForm />
    <div class="stack-md" style="gap:20px">
      <div class="info-card">
        <h2>Sterling Pension Group LLC</h2>
        <p class="row"><Icon name="pin" size={20} /><span>15 N Main St #100<br />West Hartford, CT 06107</span></p>
        <p class="row"><Icon name="phone" size={20} /><span><a href="tel:+18605907172">+1 (860) 590-7172</a><br /><a href="mailto:info@savantpensions.com">info@savantpensions.com</a></span></p>
      </div>
      <Pic class="rounded-photo" name="contact" sizes="(min-width: 760px) 35vw, 100vw" />
    </div>
  </div>
</section>

</Base>
