---
import Base from "../layouts/Base.astro";
---
<Base title="Contact | Savant Pensions">

<section class="wrap page">
  <p class="kicker">Complimentary first conversation</p>
  <h1>Contact a pension plan administrator.</h1>
  <p class="lede">No script. No pressure.</p>
</section>
<section class="section wrap split">
  <div>
    <p>Savant Pensions LLC<br />15 N Main St #100<br />West Hartford, CT 06107</p>
    <p><a href="tel:+18605907172">+1 (860) 590-7172</a><br /><a href="mailto:info@savantpensions.com">info@savantpensions.com</a></p>
  </div>
  <form class="panel" id="contact">
    <label>Name<input name="name" required /></label>
    <label>Email<input type="email" name="email" required /></label>
    <label>Phone<input type="tel" name="phone" /></label>
    <label>What would you like to explore?<textarea name="message" rows="4"></textarea></label>
    <button class="btn primary" type="submit">Request a complimentary call</button>
    <p id="thanks" hidden>Thank you. We’ll be in touch. Or call +1 (860) 590-7172.</p>
  </form>
</section>
<script>
  document.getElementById("contact")?.addEventListener("submit", (e) => {
    e.preventDefault();
    document.getElementById("thanks").hidden = false;
    e.currentTarget.querySelector("button").disabled = true;
  });
</script>

</Base>
