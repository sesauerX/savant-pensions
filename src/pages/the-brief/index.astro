---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/PostCard.astro";
import { posts } from "../../lib/posts";
import { topics, topicByDate } from "../../lib/topics";
import Pic from "../../components/Pic.astro";
import { formatDate } from "../../lib/posts";
const years = [...new Set(posts.map((p) => p.date.slice(0, 4)))];
const [latest] = posts;
---
<Base>
  <Hero crumbs={[{ label: "The Brief" }]} title="The Brief" lede="A note every two weeks, written to the limits that were current that week." variant="overlap-sm" />

  <section class="wrap filter-wrap" aria-label="Filter briefings">
    <div class="filter-card">
      <div class="filter-row">
        <div class="field search">
          <label for="brief-search" class="sr-only">Search The Brief</label>
          <Icon name="search" size={20} />
          <input id="brief-search" type="search" placeholder="Search articles" autocomplete="off" />
        </div>
        <div class="field year">
          <label for="brief-year" class="sr-only">Year</label>
          <select id="brief-year">
            <option value="all">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>
      </div>
      <div class="chips" role="group" aria-label="Filter by topic">
        <button type="button" data-topic="all" aria-pressed="true">All</button>
        {topics.map((t) => <button type="button" data-topic={t} aria-pressed="false">{t}</button>)}
      </div>
    </div>
  </section>

  <section class="wrap" id="brief-featured" style="padding-top:40px">
    <article class="featured">
      <a class="cover" href={`/the-brief/${latest.slug}`} tabindex="-1" aria-hidden="true"><Pic name={`cover-${latest.date}`} alt="" priority sizes="(min-width: 760px) 55vw, 100vw" /><span class="latest-tag">Latest</span></a>
      <div class="body">
        <div class="meta-row">{topicByDate[latest.date] && <span class="chip">{topicByDate[latest.date]}</span>}<time datetime={latest.date}>{formatDate(latest.date)}</time></div>
        <h2><a href={`/the-brief/${latest.slug}`}>{latest.title}</a></h2>
        <p>{latest.description}</p>
        <a class="text-link" href={`/the-brief/${latest.slug}`} style="align-self:flex-start">Read article →</a>
      </div>
    </article>
  </section>

  <section class="wrap section stack-lg" id="brief-grid" style="padding-top:32px;scroll-margin-top:100px">
    <p class="count-text" id="brief-count" aria-live="polite">{posts.length} briefings</p>
    <div class="post-grid">
      {posts.map((post, i) => <PostCard post={post} heading="h2" lazy={i > 5} />)}
    </div>
    <div class="empty" id="brief-empty" hidden>
      <h2>No posts match</h2>
      <p>Try a different search, topic or year.</p>
      <button type="button" class="btn secondary" id="brief-clear">Clear filters</button>
    </div>
    <nav class="pager" id="brief-pager" aria-label="Pagination"></nav>
  </section>
</Base>
<style>
  .hero.overlap-sm :global(.hero-inner) { padding-bottom: clamp(88px, 9vw, 120px); }
  .filter-wrap { position: relative; z-index: 2; margin-top: -56px; }
  .featured .cover { position: relative; }
  .latest-tag { position: absolute; left: 20px; top: 20px; z-index: 1; background: var(--gold); color: var(--navy); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; padding: 6px 10px; border-radius: 3px; text-transform: uppercase; }
</style>
<script>
  const PER_PAGE = 12;
  const cards = [...document.querySelectorAll<HTMLElement>(".post-card")];
  const featured = document.getElementById("brief-featured")!;
  const search = document.getElementById("brief-search") as HTMLInputElement;
  const year = document.getElementById("brief-year") as HTMLSelectElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chips button")];
  const count = document.getElementById("brief-count")!;
  const empty = document.getElementById("brief-empty")!;
  const pager = document.getElementById("brief-pager")!;
  const grid = document.getElementById("brief-grid")!;
  const params = new URLSearchParams(location.search);
  const state = {
    q: params.get("q") ?? "",
    topic: params.get("topic") ?? "all",
    year: params.get("year") ?? "all",
    page: Math.max(1, parseInt(params.get("page") ?? "1", 10) || 1),
  };
  search.value = state.q;
  if ([...year.options].some((o) => o.value === state.year)) year.value = state.year;
  else state.year = "all";
  if (!chips.some((c) => c.dataset.topic === state.topic)) state.topic = "all";

  const sync = () => {
    const p = new URLSearchParams();
    if (state.q) p.set("q", state.q);
    if (state.topic !== "all") p.set("topic", state.topic);
    if (state.year !== "all") p.set("year", state.year);
    if (state.page > 1) p.set("page", String(state.page));
    const qs = p.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  };

  const render = (scroll = false) => {
    const q = state.q.trim().toLowerCase();
    const unfiltered = !q && state.topic === "all" && state.year === "all";
    const pool = unfiltered ? cards.slice(1) : cards;
    const matches = pool.filter((c) =>
      (!q || c.dataset.title!.includes(q) || c.dataset.excerpt!.includes(q)) &&
      (state.topic === "all" || c.dataset.topic === state.topic) &&
      (state.year === "all" || c.dataset.year === state.year));
    const pages = Math.max(1, Math.ceil(matches.length / PER_PAGE));
    state.page = Math.min(state.page, pages);
    const start = (state.page - 1) * PER_PAGE;
    const shown = new Set(matches.slice(start, start + PER_PAGE));
    featured.hidden = !(unfiltered && state.page === 1);
    cards.forEach((c) => (c.hidden = !shown.has(c)));
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.topic === state.topic)));
    count.textContent = unfiltered
      ? `${cards.length} articles`
      : `${matches.length} of ${cards.length} articles`;
    empty.hidden = matches.length > 0;
    pager.innerHTML = "";
    if (pages > 1) {
      const btn = (label: string, page: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) => {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = label;
        if (opts.aria) b.setAttribute("aria-label", opts.aria);
        if (opts.current) b.setAttribute("aria-current", "page");
        b.disabled = !!opts.disabled;
        b.addEventListener("click", () => { state.page = page; render(true); });
        pager.append(b);
      };
      btn("Prev", state.page - 1, { disabled: state.page === 1 });
      for (let i = 1; i <= pages; i++) btn(String(i), i, { current: i === state.page, aria: `Page ${i}` });
      btn("Next", state.page + 1, { disabled: state.page === pages });
    }
    sync();
    if (scroll) grid.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  };

  let t: number | undefined;
  search.addEventListener("input", () => {
    clearTimeout(t);
    t = window.setTimeout(() => { state.q = search.value; state.page = 1; render(); }, 200);
  });
  year.addEventListener("change", () => { state.year = year.value; state.page = 1; render(); });
  chips.forEach((c) => c.addEventListener("click", () => { state.topic = c.dataset.topic!; state.page = 1; render(); }));
  document.getElementById("brief-clear")!.addEventListener("click", () => {
    Object.assign(state, { q: "", topic: "all", year: "all", page: 1 });
    search.value = "";
    year.value = "all";
    render();
  });
  render();
</script>
